    <!-- Permissions -->
    <string name="permission_title">Permissions</string>
    <string name="permission_intro">Grant the following permissions so EyeGuard can work properly:</string>
    <string name="perm_notification_title">Notifications</string>
    <string name="perm_notification_desc">Used for eye-care reminders and the persistent guard status (Android 13+)</string>
    <string name="perm_camera_title">Camera</string>
    <string name="perm_camera_desc">Opens the front camera briefly (one frame every 30s) to measure face distance, then releases it immediately</string>
    <string name="perm_banner_title">Banner notifications (important)</string>
    <string name="perm_banner_desc">Controls whether reminders pop up on screen. If "silent notifications" was ever enabled, the channel importance is demoted and will not recover by itself — open channel settings and set importance to the highest level</string>
    <string name="perm_dnd_title">DND exception (recommended)</string>
    <string name="perm_dnd_desc">Sound and vibration are suppressed by the system in silent/DND mode (no app can bypass this). Adding EyeGuard as a DND exception lets alerts ring and vibrate during DND</string>
    <string name="perm_battery_title">Battery optimization whitelist</string>
    <string name="perm_battery_desc">Prevents the system from freezing EyeGuard in the background. Without it, reminders stop working after the app stays in background or the screen is off for a while</string>
    <string name="perm_overlay_title">Display over other apps (optional)</string>
    <string name="perm_overlay_desc">Used for the eye comfort filter. Distance, light and usage reminders work without it</string>
    <string name="perm_rom_note">Extra steps on Chinese ROMs (MIUI / EMUI / ColorOS): Settings → Apps → EyeGuard → allow auto-launch; set battery strategy to "Unrestricted", otherwise the background service will be killed and distance detection stops.</string>
