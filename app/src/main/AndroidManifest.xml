<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 距离检测：前置相机拍照 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ 发送通知需运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务及类型（API 34 必须按类型声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 唤醒锁：采样闹钟到期时 CPU 可用 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 护眼遮罩悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        忽略电池优化：国产 ROM（荣耀/华为/小米等）默认把应用放入省电管控，
        锁屏或退到后台一段时间后冻结进程，导致前台服务被杀、提醒不再弹出。
        加入电池优化白名单后进程才可常驻后台。该权限引导用户跳系统弹窗确认。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机广播：重启后提醒用户一键恢复守护（不直接起前台服务，Android 12+ 限制） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".EyeGuardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EyeGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EyeGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            常驻护眼监控前台服务。
            camera：采样时短暂使用前置相机拍一帧；
            specialUse：在国产 ROM 上作为"特殊用途"前台服务提升后台存活率，
            需要在系统"自启动管理/省电策略"中手动设为允许，见服务内注释。
        -->
        <service
            android:name=".feature.filter.EyeFilterTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_view"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".core.service.EyeGuardService"
            android:exported="false"
            android:foregroundServiceType="camera|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="eye_health_monitoring" />
        </service>

        <!-- 开机兜底：重启后提醒一键恢复守护 -->
        <receiver
            android:name=".core.boot.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
